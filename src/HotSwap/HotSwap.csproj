<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>HotSwap</AssemblyName>
    <RootNamespace>HotSwap</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <Authors>Thayna</Authors>
    <Product>HotSwap</Product>
    <Description>Utilitário de bandeja para trocar resolução e Hz do monitor com um duplo clique, e trocar o conteúdo entre telas.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ThayTTG/HotSwap</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ThayTTG/HotSwap</RepositoryUrl>

    <!-- Gera um único .exe autocontido (não precisa instalar .NET na máquina que rodar) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ícone embutido no .exe: o app lê daqui (todos os tamanhos, 16–256 px),
         então funciona mesmo no build de arquivo único, sem app.ico ao lado. -->
    <EmbeddedResource Include="app.ico" LogicalName="HotSwap.app.ico" />
  </ItemGroup>

</Project>
